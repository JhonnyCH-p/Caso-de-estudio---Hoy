{
  "name": "auto-ventas-pro",
  "version": "1.0.0",
  "description": "AutoVentas Pro - Sistema Web para Gestión de Concesionaria Automotriz",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "npx prisma studio",
    "test:entity-usuario": "tsx tests/test-usuario-entity.ts",
    "test:repository-usuario": "tsx tests/test-usuario-repository.ts",
    "test:service-usuario": "tsx tests/test-usuario-service.ts",
    "test:entity-empleado": "tsx tests/test-empleado-entity.ts",
    "test:repository-empleado": "tsx tests/test-empleado-repository.ts",
    "test:service-empleado": "tsx tests/test-empleado-service.ts",
    "test:vehiculo": "tsx tests/test-vehiculo.ts",
    "test:repo-vehiculo": "tsx tests/test-vehiculo-repository.ts",
    "test:entity-plan": "tsx tests/test-plan-entity.ts",
    "test:usuario": "tsx tests/test-usuario-entity.ts && tsx tests/test-usuario-repository.ts && tsx tests/test-usuario-service.ts",
    "test:empleado": "tsx tests/test-empleado-entity.ts && tsx tests/test-empleado-repository.ts && tsx tests/test-empleado-service.ts",
    "test:vehiculos": "tsx tests/test-vehiculo.ts && tsx tests/test-vehiculo-repository.ts",
    "test:planes": "tsx tests/test-plan-entity.ts",
    "test:cotizaciones": "tsx tests/test-cotizacion-entity.ts",
    "test:ventas": "tsx tests/test-venta-entity.ts",
    "test:all": "npm run test:usuario && npm run test:empleado && npm run test:vehiculos && npm run test:planes && npm run test:cotizaciones && npm run test:ventas",
    "test": "npm run test:all"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.110.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0"
  }
}
